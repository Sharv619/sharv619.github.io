# =============================================================================
# AWS CONFIGURATION - Required for RAG Chatbot Deployment
# =============================================================================
# Copy this to .env.local and fill in your values
# DO NOT commit .env.local to version control!

# -----------------------------------------------------------------------------
# AWS CREDENTIALS
# -----------------------------------------------------------------------------
# Create via AWS Console: IAM → Users → Create Access Key
# Recommended: Use AWS CLI - run 'aws configure'
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# -----------------------------------------------------------------------------
# AWS REGION
# -----------------------------------------------------------------------------
# Choose your nearest region
# Options: us-east-1, us-west-2, ap-southeast-2 (Sydney), etc.
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# DATABASE (RDS with pgvector)
# -----------------------------------------------------------------------------
# After creating RDS instance, add these:
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=assistant_kb
DB_USER=admin
DB_PASSWORD=your_secure_password

# -----------------------------------------------------------------------------
# S3 BUCKET (Knowledge Base Storage)
# -----------------------------------------------------------------------------
# Created via deploy-infrastructure.js or manually:
KB_S3_BUCKET=sharv619-knowledge-base

# -----------------------------------------------------------------------------
# BEDROCK CONFIGURATION
# -----------------------------------------------------------------------------
# Get from AWS Console: Amazon Bedrock → Model access
# Enable: Claude 3 Haiku, Claude 3.5 Sonnet, Titan Text Embeddings
GUARDRAIL_ID=your_guardrail_id_from_aws_console

# -----------------------------------------------------------------------------
# LAMBDA FUNCTION
# -----------------------------------------------------------------------------
# After deploying Lambda:
LAMBDA_FUNCTION_NAME=Assistant-RAG-Orchestrator

# -----------------------------------------------------------------------------
# API GATEWAY (Chatbot Endpoint)
# -----------------------------------------------------------------------------
# Created automatically by deploy-infrastructure.js
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_ASSISTANT_API=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/assistant

# =============================================================================
# DEVELOPMENT ONLY (Frontend)
# =============================================================================
# Set to 'true' to use demo mode (no AWS required)
NEXT_PUBLIC_DEMO_MODE=true

# =============================================================================
# MCP SERVER (Optional)
# =============================================================================
# For local MCP server (development only)
MCP_SERVER_PORT=3001